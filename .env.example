# Copy this file to .env.local and edit it for your machine.
# Usage:
#   cp .env.example .env.local
#   source .env.local

_AWESOME_QVLA_ENV_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

export AWESOME_QVLA_ROOT="${AWESOME_QVLA_ROOT:-$_AWESOME_QVLA_ENV_DIR}"
export WORKSPACE="${WORKSPACE:-$(cd "$AWESOME_QVLA_ROOT/.." && pwd)}"
export QUANTVLA_ROOT="$AWESOME_QVLA_ROOT"

export AWESOME_QVLA_CONDA_ENV="${AWESOME_QVLA_CONDA_ENV:-awesome_quant_vla}"
export QUANTVLA_CONDA_ENV="$AWESOME_QVLA_CONDA_ENV"
export CONDA_ROOT="${CONDA_ROOT:-$HOME/miniconda3}"

export CHECKPOINTS_ROOT="${CHECKPOINTS_ROOT:-$WORKSPACE/checkpoints}"
export LIBERO_ROOT="${LIBERO_ROOT:-$WORKSPACE/LIBERO}"
export LIBERO_CONFIG_PATH="${LIBERO_CONFIG_PATH:-$HOME/.libero}"

export AWESOME_QVLA_CACHE_ROOT="${AWESOME_QVLA_CACHE_ROOT:-$HOME/.cache/awesome_quant_vla}"
export QUANTVLA_CACHE_ROOT="$AWESOME_QVLA_CACHE_ROOT"

# Pi0.5/OpenPI.
export OPENPI_ROOT="${OPENPI_ROOT:-$WORKSPACE/openpi}"
export OPENPI_PY="${OPENPI_PY:-$OPENPI_ROOT/.venv/bin/python}"

# OpenVLA/QVLA. Use a separate OpenVLA conda env when reproducing QVLA results.
export OPENVLA_PYTHON="${OPENVLA_PYTHON:-python}"
export OPENVLA_CKPT="${OPENVLA_CKPT:-$CHECKPOINTS_ROOT/openvla-7b-finetuned-libero-spatial}"
export OPENVLA_OFT_CKPT="${OPENVLA_OFT_CKPT:-$CHECKPOINTS_ROOT/openvla-7b-oft-finetuned-libero-spatial}"
export OPENVLA_ATTN_IMPL="${OPENVLA_ATTN_IMPL:-eager}"

# UniVLA. UniVLA uses an action decoder in addition to the HF checkpoint.
export UNIVLA_PYTHON="${UNIVLA_PYTHON:-$OPENVLA_PYTHON}"
export UNIVLA_REPO_ROOT="${UNIVLA_REPO_ROOT:-$CHECKPOINTS_ROOT/univla-7b-224-sft-libero}"
export UNIVLA_CKPT="${UNIVLA_CKPT:-$UNIVLA_REPO_ROOT/univla-libero-spatial}"
export UNIVLA_ACTION_DECODER="${UNIVLA_ACTION_DECODER:-$UNIVLA_CKPT/action_decoder.pt}"
export UNIVLA_ATTN_IMPL="${UNIVLA_ATTN_IMPL:-eager}"

# Optional for mainland China networks.
# export HF_ENDPOINT=https://hf-mirror.com
# export HF_HUB_DISABLE_XET=1

unset _AWESOME_QVLA_ENV_DIR
